# ============================================================================
# CoachRank.lol — environment
# Copy to .env.local and fill in. NEVER commit real values.
# ============================================================================

# ---- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OG images,
# sitemap entries and the return_url handed to Dodo checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---- Firebase Admin (server) ----------------------------------------------
# Either paste the whole service-account JSON (raw or base64) here...
FIREBASE_SERVICE_ACCOUNT_JSON=

# ...or provide the three fields individually. Newlines in the private key may
# be written as literal \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firestore database inside the project. Leave unset for "(default)". Set this when
# CoachRank shares a Firebase project with another app, so it gets its own database and
# never touches that app's data, rules or indexes.
# FIREBASE_DATABASE_ID=coachrank

# Local development against the Firestore emulator. When this is set, no
# service-account credentials are required.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# The two above are server-side only. The browser SDK needs its own pair, so admin
# sign-in and the live activity feed also reach the emulators during development.
# Leave both unset in production.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080


# ---- Firebase Web SDK (public) --------------------------------------------
# Powers exactly two things in the browser: the live Latest Activity feed and
# admin sign-in. Safe to expose — Firestore rules make the client read-only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match FIREBASE_DATABASE_ID above, or the live activity feed reads the wrong database.
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=coachrank


# ---- Dodo Payments ---------------------------------------------------------
# API key from the Dodo dashboard (Developer → API keys).
DODO_PAYMENTS_API_KEY=

# test_mode or live_mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Webhook signing secret from Dodo (Developer → Webhooks). Without it every
# webhook is rejected with 401 and nothing is ever credited.
DODO_PAYMENTS_WEBHOOK_KEY=

# One-time products with "Pay what you want" ENABLED. The exact amount is set
# per checkout, so a $10 top-up and a $505 claim for #1 use the same product.
DODO_BID_PRODUCT_ID=
# Optional; falls back to DODO_BID_PRODUCT_ID when unset.
DODO_SPOTLIGHT_PRODUCT_ID=


# ---- Admin -----------------------------------------------------------------
# Comma-separated. Only these Firebase Auth accounts can reach /admin.
ADMIN_EMAILS=you@example.com


# ---- Pricing defaults (dollars) -------------------------------------------
# Build-time fallbacks only. Once settings/pricing exists in Firestore, the
# admin Settings screen is the source of truth.
DEFAULT_MIN_NEW_BID_USD=5
DEFAULT_TOP_POSITION_INCREMENT_USD=5
DEFAULT_STANDARD_INCREMENT_USD=1
DEFAULT_PREMIUM_SPOTLIGHT_USD=19
DEFAULT_STANDARD_SPOTLIGHT_USD=9


# ---- Optional --------------------------------------------------------------
# Set to "false" to switch off the live "N online" counter and its heartbeats.
NEXT_PUBLIC_ENABLE_PRESENCE=true

# Set to "true" to stop the icon route calling public favicon services; every
# listing then renders a generated initials avatar.
DISABLE_REMOTE_FAVICONS=false
